{
  "name": "odderon-flight-deck",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:stations": "node scripts/stations.mjs",
    "dev": "npm run prepare:stations && vite --host 0.0.0.0",
