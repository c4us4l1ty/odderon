{
  "name": "odderon-tools",
  "private": true,
  "type": "module",
  "description": "Development tooling. The game itself is Rust -> wasm; this is only the harness that runs what CI compiles (see tools/README.md).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch:wasm": "gh run download --name wasm -D dist --clobber || node -e \"console.error('no wasm artifact yet: push the branch and let ci build it'); process.exit(1)\"",
    "determinism": "node tools/determinism.mjs",
    "gl:info": "node tools/gl-info.mjs",
    "check": "npm run determinism",
    "install:chromium": "node -e \"require('@sparticuz/chromium').executablePath().then(p=>console.log('chromium:',p))\"",
    "serve": "node tools/serve.mjs",
    "check:shell": "node tools/check-shell.mjs",
    "check:paths": "node tools/check-static-path.mjs",
    "check:workflows": "node tools/check-workflows.mjs",
    "capture:page": "node tools/capture-page.mjs",
    "start": "node tools/serve.mjs",
    "check:ablation": "node tools/check-ablation.mjs",
    "check:cache": "node tools/check-cache.mjs",
    "check:classes": "node tools/check-classes.mjs && node tools/check-classes-selftest.mjs",
    "check:rocket": "node tools/check-rocket.mjs",
    "check:orbit-mission": "node tools/check-orbit-mission.mjs",
    "check:lighttime": "node tools/check-lighttime.mjs",
    "check:rendezvous": "node tools/check-rendezvous.mjs",
    "check:archive": "node tools/check-archive.mjs",
    "check:protege": "node tools/check-protege.mjs",
    "check:causal-mail": "node tools/check-causal-mail.mjs",
    "check:mission": "node tools/check-mission.mjs",
    "check:essence": "node tools/check-essence.mjs",
    "check:anomaly": "node tools/check-anomaly.mjs"
  },
  "devDependencies": {
    "@sparticuz/chromium": "131.0.0",
    "js-yaml": "4.1.0",
    "puppeteer-core": "23.11.1"
  }
}
